<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mobile Jump Game</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #2c3e50;
            font-family: 'Arial', sans-serif;
            touch-action: manipulation; /* ป้องกันการซูมเมื่อแตะรัวๆ */
        }
        #gameCanvas {
            display: block;
            background-color: #ecf0f1;
        }
        .ui-overlay {
            position: absolute;
            top: 20px;
            width: 100%;
            text-align: center;
            color: #fff;
            pointer-events: none;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>

    <div class="ui-overlay">
        <h2 id="score">Score: 0</h2>
        <p>แตะหน้าจอเพื่อกระโดด</p>
    </div>
    <canvas id="gameCanvas"></canvas>

<script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");
    const scoreElement = document.getElementById("score");

    // ปรับขนาด Canvas ให้เต็มหน้าจอมือถือ
    function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    let score = 0;
    let gameActive = true;
    let frameCount = 0;

    // ตัวละคร (ปรับขนาดตามความกว้างหน้าจอเล็กน้อย)
    const player = {
        x: 50,
        y: canvas.height - 100,
        width: 40,
        height: 40,
        color: "#e74c3c",
        dy: 0,
        jumpForce: 15, // แรงกระโดด
        gravity: 0.8,
        grounded: false
    };

    const obstacles = [];

    function createObstacle() {
        const height = Math.random() * (60 - 30) + 30;
        obstacles.push({
            x: canvas.width,
            y: canvas.height - height,
            width: 30,
            height: height,
            color: "#34495e",
            speed: 6 + (score / 5)
        });
    }

    function jump() {
        if (player.grounded && gameActive) {
            player.dy = -player.jumpForce;
            player.grounded = false;
        }
    }

    // รองรับทั้งการแตะหน้าจอ (Touch) และ Spacebar
    window.addEventListener("touchstart", (e) => {
        e.preventDefault(); // ป้องกันการเลื่อนหน้าจอขณะเล่น
        jump();
    }, { passive: false });

    window.addEventListener("keydown", (e) => {
        if (e.code === "Space") jump();
    });

    function update() {
        if (!gameActive) return;

        player.dy += player.gravity;
        player.y += player.dy;

        // เช็คพื้นดิน
        if (player.y + player.height > canvas.height) {
            player.y = canvas.height - player.height;
            player.dy = 0;
            player.grounded = true;
        }

        // สิ่งกีดขวาง
        if (frameCount % 80 === 0) createObstacle();
        
        for (let i = obstacles.length - 1; i >= 0; i--) {
            obstacles[i].x -= obstacles[i].speed;

            // Collision Detection
            if (
                player.x < obstacles[i].x + obstacles[i].width &&
                player.x + player.width > obstacles[i].x &&
                player.y < obstacles[i].y + obstacles[i].height &&
                player.y + player.height > obstacles[i].y
            ) {
                gameOver();
            }

            if (obstacles[i].x + obstacles[i].width < 0) {
                obstacles.splice(i, 1);
                score++;
                scoreElement.innerText = `Score: ${score}`;
            }
        }
        frameCount++;
    }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // วาดตัวละคร
        ctx.fillStyle = player.color;
        ctx.shadowBlur = 10;
        ctx.shadowColor = "rgba(0,0,0,0.2)";
        ctx.fillRect(player.x, player.y, player.width, player.height);

        // วาดสิ่งกีดขวาง
        ctx.shadowBlur = 0;
        ctx.fillStyle = "#34495e";
        obstacles.forEach(obs => {
            ctx.fillRect(obs.x, obs.y, obs.width, obs.height);
        });
    }

    function loop() {
        update();
        draw();
        if (gameActive) requestAnimationFrame(loop);
    }

    function gameOver() {
        gameActive = false;
        alert("จบเกม! คะแนนของคุณคือ: " + score);
        location.reload();
    }

    loop();
</script>
</body>
</html>
